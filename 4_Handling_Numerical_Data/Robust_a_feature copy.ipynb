   "source": [
    "import pandas as pd\n",
    "from sklearn import preprocessing\n",
    "df = pd.read_csv(\"titanic.csv\")\n",
    "feature_age = df['Age'].to_numpy().reshape(-1,1)\n",
    "print(feature_age)\n",
    "robust_scale = preprocessing.RobustScaler()\n",
    "\n",
    "scaled_feature = robust_scale.fit_transform(feature_age)\n",
    "print(scaled_feature)\n"
   ]
